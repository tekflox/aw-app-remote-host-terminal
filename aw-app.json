{
  "manifest_version": 1,
  "id": "remote-host-terminal",
  "name": "Remote Host Terminal",
  "version": "0.4.0",
  "description": "Open interactive terminals on every remote host linked to your account, with multiple sessions side by side in one workspace window.",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "low"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "remote_host_terminal_app.plugin:RemoteHostTerminalAppPlugin",
    "pip_requires": []
  },
  "permissions": [
    "routes:register",
    "net:outbound",
    "ui:code"
  ],
  "contributes": {
    "routes": [
      {
        "prefix": "/api/apps/remote-host-terminal"
      }
    ],
    "windows": [
      {
        "id": "remote-host-terminal.main",
        "title": "Remote Host Terminal",
        "icon": "terminal",
        "body": {
          "type": "component"
        }
      }
    ],
    "frontend": {
      "mode": "component",
      "bundle": "ui/dist/remote-host-terminal.js",
      "slots": [
        "core.window.body:remote-host-terminal.main"
      ]
    }
  },
  "dependencies": {},
  "migrations": {}
}
